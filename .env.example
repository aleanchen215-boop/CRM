# Base de datos (Supabase Postgres — usar la connection string "Direct connection",
# no la de pgbouncer/pooler, para que funcione bien con el driver adapter de Prisma).
DATABASE_URL="postgresql://postgres:password@db.xxxxxxxxxxxx.supabase.co:5432/postgres"

# Supabase Auth / Storage (Project Settings > API en el dashboard de Supabase)
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJ..."

# --- Variables de fases siguientes (no requeridas para la Fase 0) ---

