# Base de datos (Supabase Postgres). Usar la connection string "Session pooler"
# (Connect > URI > Session pooler) — la "Direct connection" solo resuelve por IPv6
# y la mayoría de los entornos (incluido este) no tienen salida IPv6.
DATABASE_URL="postgresql://postgres.xxxxxxxxxxxx:password@aws-0-xx-xxxx-1.pooler.supabase.com:5432/postgres"

# Supabase Auth / Storage (Project Settings > API en el dashboard de Supabase)
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJ..."

# --- Variables de fases siguientes (no requeridas para la Fase 0) ---

# OpenAI (Fase 2: asistente de IA sobre WhatsApp)
# OPENAI_API_KEY=""

# WhatsApp Cloud API — Meta Business (Fase 1: recepción/envío de mensajes)
# WHATSAPP_ACCESS_TOKEN: token del System User (Meta > Business Settings > System Users)
# WHATSAPP_PHONE_NUMBER_ID: WhatsApp > API Setup, en el dashboard de la app de Meta
# WHATSAPP_VERIFY_TOKEN: cualquier string que elijas vos, se configura igual en Meta
# WHATSAPP_APP_SECRET: Meta > App Settings > Basic
# WHATSAPP_ACCESS_TOKEN=""
# WHATSAPP_PHONE_NUMBER_ID=""
# WHATSAPP_VERIFY_TOKEN=""
# WHATSAPP_APP_SECRET=""

# Mercado Pago (Fase 1: cobros y webhooks de pago)
# MERCADO_PAGO_ACCESS_TOKEN=""
# MERCADO_PAGO_WEBHOOK_SECRET=""

# Inngest (Fase 2: colas para procesar mensajes de WhatsApp de forma asíncrona)
# INNGEST_EVENT_KEY=""
# INNGEST_SIGNING_KEY=""
