# Base de datos (Supabase Postgres). Usar la connection string "Session pooler"
# (Connect > URI > Session pooler) — la "Direct connection" solo resuelve por IPv6
# y la mayoría de los entornos (incluido este) no tienen salida IPv6.
DATABASE_URL="postgresql://postgres.xxxxxxxxxxxx:password@aws-0-xx-xxxx-1.pooler.supabase.com:5432/postgres"

# Supabase Auth / Storage (Project Settings > API en el dashboard de Supabase)
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJ..."

# --- Variables de fases siguientes (no requeridas para la Fase 0) ---

# OpenAI (Fase 2: asistente de IA sobre WhatsApp)
# OPENAI_API_KEY=""

# WhatsApp vía YCloud (BSP) — Fase 1: recepción/envío de mensajes
# YCLOUD_API_KEY: YCloud Console > Developers > API Keys
# WHATSAPP_PHONE_NUMBER: tu número de WhatsApp Business vinculado en YCloud (E.164, ej "+5493434538904")
# YCLOUD_WEBHOOK_SECRET: se genera al agregar el endpoint en YCloud Console > Developers > Webhook
# YCLOUD_API_KEY=""
# WHATSAPP_PHONE_NUMBER=""
# YCLOUD_WEBHOOK_SECRET=""

# Mercado Pago (Fase 1: cobros y webhooks de pago)
# MERCADO_PAGO_ACCESS_TOKEN=""
# MERCADO_PAGO_WEBHOOK_SECRET=""

# Inngest (Fase 2: colas para procesar mensajes de WhatsApp de forma asíncrona)
# INNGEST_EVENT_KEY=""
# INNGEST_SIGNING_KEY=""
